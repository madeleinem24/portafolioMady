# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Variables de entorno requeridas (CLAUDE.md §11)
# Copiar este archivo a .env.local y rellenar los valores reales.
# NUNCA commitear .env.local
# ─────────────────────────────────────────────────────────────────────────────

# GitHub Actions (Settings → Secrets → Actions) — mismo valor que en .env.local
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=  → secret con ese nombre para el deploy

# Cloudinary — Dashboard > Product environment credentials
# Cloud name: público, va embebido en las URLs de delivery del front-end
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# SDK URL: privado (API key + secret), solo para scripts de subida/admin
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Opcional — para formulario de contacto (Fase 6)
# RESEND_API_KEY=re_xxxx
# CONTACT_EMAIL=
