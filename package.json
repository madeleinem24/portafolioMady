{
  "name": "madeleine-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev":       "next dev --turbopack",
    "build":     "next build",
    "preview":   "npx serve out -p 3001",
    "export":    "next build",
    "typecheck": "tsc --noEmit",
    "lint":      "next lint",
    "lint:fix":  "next lint --fix",
    "format":    "prettier --write .",
    "analyze":   "ANALYZE=true next build",
    "deploy":          "pnpm build && gh-pages -d out",
    "compress-video":  "python videos/conversor_videos.py"
  },
  "dependencies": {
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.0",
    "gh-pages": "^6.0.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.5.0"
  }
}
